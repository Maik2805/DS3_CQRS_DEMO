# Wallet CQRS + Event Sourcing POC â€” environment template (task 12.2, Req 15.6).
#
# Copy this file to `.env` before running the stack:
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#   docker compose up --build
#
# compose.yml interpolates ${READ_DB_PASSWORD}, ${ADMIN_TOKEN} and
# ${READ_PROJECTION_DELAY_MS} from this file at startup. Credentials live ONLY here â€”
# they are not hardcoded across the compose file or the services (Req 15.6).
#
# Variable names below match EXACTLY what compose.yml and the services consume.
# For a local POC these simple credentials are fine; change them for anything shared.

# --- Axon Server connection (consumed by write-service) ---
AXON_SERVER_HOST=axon-server
AXON_SERVER_PORT=8124
AXON_SERVER_CONTEXT=default

# --- PostgreSQL Read Model connection (consumed by read-service) ---
# READ_DB_PORT is the container-internal port (5432); the host maps it to 5433.
READ_DB_HOST=postgres-read
READ_DB_PORT=5432
READ_DB_NAME=wallet_read
READ_DB_USER=wallet_read
# Used for BOTH the postgres-read container (POSTGRES_PASSWORD) and the read-service
# connection â€” the single source of truth for the Read Model credential.
READ_DB_PASSWORD=wallet_read_password

# --- Read Side: Axon Server admin API + persistent-stream / rebuild wiring ---
AXON_ADMIN_URL=http://axon-server:8024
PERSISTENT_STREAM_NAME=wallet-read-projection
ADMIN_ENDPOINT_NAME=wallet-read-service
# Shared secret guarding POST /admin/projection/rebuild (X-Admin-Token header).
# If left empty the rebuild endpoint is UNGUARDED (convenient for a local demo).
ADMIN_TOKEN=change-me

# --- Eventual-consistency demo (default 0 = no artificial delay) ---
# Milliseconds the read-service waits BEFORE projecting each event into PostgreSQL, so
# the window where the Event Store is updated but the Read Model lags is observable.
# Set e.g. 3000 for the demo; 0 (default) is a true no-op.
READ_PROJECTION_DELAY_MS=0
